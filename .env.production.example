# AutoMart — Production Environment Variables
# Copy this to .env.production and fill in real values
# For Render deployment, set these in the Render dashboard Environment tab

# ═══ SHARED (used by multiple services) ═══════════════════════════════════════
JWT_SECRET=         # 64-char random string (generate: openssl rand -base64 48)
DATABASE_URL=       # postgresql://... (Supabase connection pooler)
REDIS_URL=          # rediss://default:password@<host>.upstash.io:6379 (Upstash)

# ═══ AUTH SERVICE ═════════════════════════════════════════════════════════════
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=   # optional — Google OAuth
GOOGLE_CLIENT_SECRET=

# ═══ API GATEWAY ═════════════════════════════════════════════════════════════
API_GATEWAY_PORT=3000
CORS_ORIGINS=https://automart.vercel.app
TURNSTILE_SECRET_KEY=  # Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile (skipped when empty)

# Service URLs — auto-configured by start-prod.sh in single-container mode.
# In Docker (Render/Railway), all services run on localhost on different ports.
# The startup script sets these automatically. Only override if running services
# on separate machines.
# AUTH_SERVICE_URL=http://localhost:3001
# PRODUCT_SERVICE_URL=http://localhost:3002
# SEARCH_SERVICE_URL=http://localhost:3003
# ORDER_SERVICE_URL=http://localhost:3004
# INVENTORY_SERVICE_URL=http://localhost:3005
# NOTIFICATION_SERVICE_URL=http://localhost:3006
# MCP_SERVER_URL=http://localhost:3007
# ASSISTANT_SERVICE_URL=http://localhost:3008

# ═══ ASSISTANT SERVICE (RAG chatbot) ═════════════════════════════════════════
LLM_PROVIDER=template   # template | gemini | groq (template = no key needed)
LLM_API_KEY=            # Google AI Studio or Groq free key (optional)

# ═══ ORDER SERVICE ════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=https://automart.vercel.app
API_URL=https://automart-backend.onrender.com

# ═══ NOTIFICATION SERVICE ════════════════════════════════════════════════════
RESEND_API_KEY=     # optional — for email notifications (mock mode without it)

# ═══ FRONTEND (Vercel) ═══════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=https://automart-backend.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://mmvrkljevwgkonpljsut.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # Cloudflare Turnstile site key (widget on login/register)
